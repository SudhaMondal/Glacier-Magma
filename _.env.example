# Copy to .env (server reads it via process env; see DEPLOY.md)
PORT=3001
# REQUIRED in production: long random string  (openssl rand -hex 32)
JWT_SECRET=change-me
# Where users.json is stored (mount a persistent disk here in production)
DATA_DIR=./data
# Only needed if the client is hosted on a DIFFERENT domain than the server
CLIENT_ORIGIN=http://localhost:5173
